# Deploy stack from published images.
#
# First run:
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   replace every CHANGE_ME_* value with a generated secret (see below)
#   deploy/scripts/check-env.sh deploy/.env
#   make up-images
#
# Generate each password/secret with: openssl rand -base64 32
# ServerAccess__CredentialKey must decode to exactly 32 bytes, so use the same
# command: openssl rand -base64 32
#
# Images are published by the docker workflow of InfraOrgITApi/InfraOrgITWeb:
# main, dev, sha-<commit> on branch pushes; X.Y.Z, X.Y, sha-<commit>, latest on
# v* tags. Prefer an immutable version or sha-<commit> tag; API_DIGEST and
# WEB_DIGEST optionally pin the exact manifest (@sha256:...).
API_IMAGE=ghcr.io/senseikiritof/infraorgit-api
API_TAG=CHANGE_ME_API_TAG
API_DIGEST=
WEB_IMAGE=ghcr.io/senseikiritof/infraorgit-web
WEB_TAG=CHANGE_ME_WEB_TAG
WEB_DIGEST=

# Application and Keycloak databases.
MYSQL_PASSWORD=CHANGE_ME_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
KEYCLOAK_DB_ROOT_PASSWORD=CHANGE_ME_KEYCLOAK_DB_ROOT_PASSWORD

# Keycloak master-realm administrator. Only used on the first start.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

# Application administrator (Keycloak user "admin"). Bootstrap only: the
# imported user must change it at first login.
INFRAORGIT_ADMIN_PASSWORD=CHANGE_ME_INFRAORGIT_ADMIN_PASSWORD

# BFF client credential. Must match the realm client secret and be different
# from MCP_CLIENT_SECRET.
Oidc__ClientSecret=CHANGE_ME_OIDC_CLIENT_SECRET
# Service-account secret for the infraorgit-mcp client.
MCP_CLIENT_SECRET=CHANGE_ME_MCP_CLIENT_SECRET

# AES key for SSH credentials: base64 of 32 random bytes.
ServerAccess__CredentialKey=CHANGE_ME_CREDENTIAL_KEY
ServerAccess__CurrentKeyVersion=1

# Loopback by default. Set WEB_BIND=0.0.0.0 (or a specific interface IP) only
# for an intentional network exposure with TLS and firewall rules.
WEB_BIND=127.0.0.1
SITE_ADDRESS=localhost
API_UPSTREAM=api:8080
SITE_URL=https://localhost:8443
# Public admin console origin; the web front door only exposes 8443.
KEYCLOAK_HOSTNAME_ADMIN=http://localhost:18081
KEYCLOAK_UPSTREAM=keycloak:8080

# MCP endpoint. The deploy realm gives infraorgit-mcp mcp:read by default;
# mcp:operate and tunnels:operate are optional and must be enabled per client.
MCP_ENABLED=true

# Optional: decrypts appsettings.<Environment>.Secure.json (SSecureUtils AddSecureConfig)
# ENC_KEY=
