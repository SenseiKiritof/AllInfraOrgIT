# Deploy stack from published images. Copy to .env and edit the secrets/tags.
# Images are published by the docker workflow of InfraOrgITApi/InfraOrgITWeb:
# main, dev, sha-<commit> on branch pushes; X.Y.Z, X.Y, sha-<commit>, latest on v* tags.
API_IMAGE=ghcr.io/senseikiritof/infraorgit-api
API_TAG=main
WEB_IMAGE=ghcr.io/senseikiritof/infraorgit-web
WEB_TAG=main

MYSQL_PASSWORD=dev-app-password
MYSQL_ROOT_PASSWORD=dev-app-root-password
KEYCLOAK_DB_PASSWORD=dev-keycloak-password
KEYCLOAK_DB_ROOT_PASSWORD=dev-keycloak-root-password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=dev-keycloak-admin
Oidc__ClientSecret=dev-client-secret
# AES key for SSH credentials: 32 random bytes in base64 (openssl rand -base64 32).
# Development placeholder: replace it in production.
ServerAccess__CredentialKey=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=
ServerAccess__CurrentKeyVersion=1
SITE_ADDRESS=localhost
API_UPSTREAM=api:8080
SITE_URL=https://localhost:8443
# Public admin console origin; the web front door only exposes 8443.
KEYCLOAK_HOSTNAME_ADMIN=http://localhost:18081
KEYCLOAK_UPSTREAM=keycloak:8080
# Optional: decrypts appsettings.<Environment>.Secure.json (SSecureUtils AddSecureConfig)
# ENC_KEY=
